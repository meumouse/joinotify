# ---------------------------------------------------------------------------
# Joinotify — local environment
#
# Copy this file to `.env` and fill in what you actually need. `.env` is
# Git-ignored; this example is the tracked documentation of what the tooling
# reads, so add every new variable here (never a real secret).
#
#   cp .env.example .env
#
# Loaded by scripts/env.mjs from the repository root, for:
#   - scripts/deploy-svn.mjs  (npm run deploy*)   — WordPress.org SVN publishing
#   - scripts/build.mjs       (npm run build*)    — release packaging
#   - scripts/lint-php.mjs    (npm run lint:php)  — PHP 8.1 syntax check
#
# A variable already present in the environment always wins over this file, so
# CI secrets are never overridden by a stray local `.env`.
# ---------------------------------------------------------------------------


# --------------------------------------------------------- WordPress.org SVN

# WordPress.org account that owns the plugin. Same login used at
# https://wordpress.org/plugins/joinotify/ — it is the SVN username too.
# Also settable per run with --username=<name>.
WPORG_USERNAME=your-wordpress-org-username

# WordPress.org password, for unattended deploys only (CI, scripted release).
#
# Leave it EMPTY for a normal deploy: svn then prompts once and caches the
# credential in its own store, and nothing ever writes the password to disk here.
# When it is set, the deploy adds --non-interactive (fail instead of hang on a
# bad credential) and --no-auth-cache (don't copy the secret into svn's store),
# and masks the value in everything it prints.
#
# WordPress.org does not issue app-specific passwords for SVN, so this is the
# account password: treat the file accordingly and never commit it.
# WPORG_PASSWORD=

# Plugin slug in the WordPress.org directory — the SVN repository is
# https://plugins.svn.wordpress.org/<slug>/. Only worth setting when deploying
# something other than joinotify. Also settable with --slug=<slug>.
# WPORG_SLUG=joinotify


# ------------------------------------------------------------------ PHP lint

# Path to a PHP 8.1 binary, the version declared in "Requires PHP". `npm run
# lint:php` parses every source file with it, so a syntax feature newer than the
# floor cannot slip through. Without this, the script tries a few common Local by
# Flywheel / XAMPP paths and then `php8.1` on PATH.
#
# Windows (Local by Flywheel):
# PHP81_BIN=C:\Users\<you>\AppData\Roaming\Local\lightning-services\php-8.1.23+2\bin\win64\php.exe
# macOS (Homebrew):
# PHP81_BIN=/opt/homebrew/opt/php@8.1/bin/php
# Linux:
# PHP81_BIN=/usr/bin/php8.1


# -------------------------------------------------------------- Translations

# Only needed to REGENERATE translations (`npm run build:translate`); a plain
# build reuses the committed catalogues and needs none of this.
#
# Running the languages/ CLI directly reads `languages/.env` instead (its own
# `languages/.env.example` documents it). Keys set here still apply to it when it
# is launched by the build, and take precedence. See languages/README.md.

# Engine used when --engine is not passed: openai | google.
# TRANSLATE_ENGINE=openai

# OpenAI (AI translation, the default engine).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Cloud Translation.
# GOOGLE_TRANSLATE_API_KEY=AIzaSy...

# Set to 1 to re-translate strings whose translation is identical to the source
# instead of leaving them alone.
# RETRANSLATE_IDENTICAL=0
